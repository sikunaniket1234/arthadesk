# Environment (never commit active secrets)
.env
.env.local
.env.*.local
.env.staging

# Keep templates
!.env.example
!.env.dev
!.env.prod

# Runtime artifacts
storage/logs/*
storage/cache/*
storage/backups/*
storage/uploads/*
storage/receipts/*
!storage/**/.gitkeep

# Documentation — only README.md (repo root) is published.
# The leading slash matters: without it the negation would re-include any
# nested README.md and pull local folders into git.
*.md
!/README.md
docs/

# Local working artifacts (never commit)
artha_desk_landing_page_updated/
artha_desk_landing_page_updated.zip
*.zip

# Docker (local development only)
docker/
docker-compose.yml

# Dependencies
/vendor/

# Hosting-server artifacts (only exist inside the deployed app root;
# public_html is a copy of public/ at deploy time and must never be committed)
/public_html/
/DO_NOT_UPLOAD_HERE
.env.tmp-*

# Sensitive / operational files
# NOTE: database/migrations and database/seeds are SOURCE CODE and stay tracked.
# Only database dumps are ignored — those are written to storage/backups anyway.
*.sql.gz
*.dump
*.log
*.key
*.pem
auth.json
!database/**/*.sql

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
