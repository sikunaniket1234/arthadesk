# Environment (never commit active secrets)
.env
.env.local
.env.*.local
.env.staging

# Keep templates
!.env.example
!.env.dev
!.env.prod

# Runtime artifacts
storage/logs/*
storage/cache/*
storage/backups/*
storage/uploads/*
storage/receipts/*
!storage/**/.gitkeep

# Documentation — only README.md is published
*.md
!README.md
docs/

# Docker (local development only)
docker/
docker-compose.yml

# Dependencies
/vendor/

# Sensitive / operational files
# NOTE: database/migrations and database/seeds are SOURCE CODE and stay tracked.
# Only database dumps are ignored — those are written to storage/backups anyway.
*.sql.gz
*.dump
*.log
*.key
*.pem
auth.json
!database/**/*.sql

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
