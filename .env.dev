APP_NAME="Artha-Desk"
APP_ENV=development
APP_DEBUG=true
APP_KEY=base64:REPLACE_WITH_OUTPUT_OF_PHP_BIN_KEY
APP_URL=http://localhost:8000
APP_BASE_PATH=/
AUTO_MIGRATE=true
SEED_DEMO=true
SESSION_LIFETIME=7200
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,or

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=arthadesk
DB_USER=arthadesk
DB_PASS=arthapass

LOG_CHANNEL=file
LOG_LEVEL=debug
LOG_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365

ENV_SWITCH_ENABLED=true
ENV_SWITCH_KEY=REPLACE_WITH_OUTPUT_OF_PHP_BIN_KEY

CAPTCHA_ENABLED=true
CAPTCHA_PROVIDER=math
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
CAPTCHA_ALLOW_MATH_IN_PRODUCTION=false

LOGIN_THROTTLE_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_IP_MAX_ATTEMPTS=20

API_REQUIRE_ORIGIN=false
API_REQUIRE_TOKEN=true
API_RATE_LIMIT=600
API_RATE_WINDOW=60
API_CHECKOUT_RATE_LIMIT=120

TENANCY_BASE_DOMAIN=localhost
TENANCY_ADMIN_HOST=admin.localhost
TENANCY_ENFORCE_HOSTS=false

# Landing page contact capture (development)
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_WHATSAPP=
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW=3600

# log driver writes the "email" to storage/logs instead of sending it
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=465
SMTP_ENCRYPTION=none
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Artha-Desk Website
