APP_NAME="Artha-Desk"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://your-domain.com
APP_BASE_PATH=/
AUTO_MIGRATE=false
SEED_DEMO=false
SESSION_LIFETIME=7200
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,or

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=arthadesk
DB_USER=arthadesk_user
DB_PASS=

LOG_CHANNEL=file
LOG_LEVEL=info
LOG_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365

ENV_SWITCH_ENABLED=false
ENV_SWITCH_KEY=

CAPTCHA_ENABLED=true
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
CAPTCHA_ALLOW_MATH_IN_PRODUCTION=false

LOGIN_THROTTLE_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_IP_MAX_ATTEMPTS=20

API_REQUIRE_ORIGIN=true
API_REQUIRE_TOKEN=true
API_RATE_LIMIT=120
API_RATE_WINDOW=60
API_CHECKOUT_RATE_LIMIT=30

TENANCY_BASE_DOMAIN=arthadesk.in
TENANCY_ADMIN_HOST=admin.arthadesk.in
TENANCY_ENFORCE_HOSTS=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@arthadesk.in
