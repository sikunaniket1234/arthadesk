APP_NAME="Artha-Desk"
APP_ENV=production
APP_DEBUG=false
APP_KEY=REPLACE_WITH_OUTPUT_OF_PHP_BIN_KEY
APP_URL=https://www.arthadesk.in
APP_BASE_PATH=/
AUTO_MIGRATE=false
SEED_DEMO=false
SESSION_LIFETIME=7200
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,or

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=REPLACE_WITH_DATABASE_NAME
DB_USER=REPLACE_WITH_DATABASE_USER
DB_PASS=REPLACE_WITH_STRONG_DATABASE_PASSWORD

LOG_CHANNEL=file
LOG_LEVEL=info
LOG_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365

ENV_SWITCH_ENABLED=true
ENV_SWITCH_KEY=REPLACE_WITH_OUTPUT_OF_PHP_BIN_KEY

CAPTCHA_ENABLED=true
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SITE_KEY=REPLACE_WITH_CLOUDFLARE_SITE_KEY
TURNSTILE_SECRET=REPLACE_WITH_CLOUDFLARE_SECRET_KEY
TURNSTILE_HOSTNAMES=arthadesk.in,www.arthadesk.in,app.arthadesk.in
CAPTCHA_ALLOW_MATH_IN_PRODUCTION=false

LOGIN_THROTTLE_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_IP_MAX_ATTEMPTS=20

API_REQUIRE_ORIGIN=true
API_REQUIRE_TOKEN=true
API_RATE_LIMIT=120
API_RATE_WINDOW=60
API_CHECKOUT_RATE_LIMIT=30

TENANCY_BASE_DOMAIN=arthadesk.in
TENANCY_ADMIN_HOST=app.arthadesk.in
TENANCY_ENFORCE_HOSTS=true

# Landing page contact capture — enquiries from https://www.arthadesk.in reach this mailbox.
CONTACT_EMAIL=hello@arthadesk.in
CONTACT_PHONE=+91-00000-00000
CONTACT_WHATSAPP=910000000000
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW=3600

# Mail delivery: mail (PHP mail(), no extra setup) | smtp (Hostinger mailbox) | log (never sends)
MAIL_DRIVER=mail
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@arthadesk.in
SMTP_FROM_NAME=Artha-Desk Website
